---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contacto | Nordikhat Software Solutions">
  <main class="pt-32 pb-xl">
    <div class="max-w-max-width mx-auto px-margin-desktop">
      <!-- Page Header -->
      <div class="mb-xl text-center md:text-left">
        <h1 class="font-headline-xl text-headline-xl text-on-surface mb-sm">
          Hablemos de tu próximo proyecto
        </h1>
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
          Estamos listos para transformar tus ideas en soluciones de software
          robustas y escalables.
        </p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
        <!-- Contact Form Section -->
        <div class="lg:col-span-7">
          <div
            class="bg-surface-container-lowest border border-outline-variant p-xl rounded-xl shadow-sm"
          >
            <form class="space-y-lg" id="contact-form">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                <div class="space-y-xs">
                  <label
                    class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider"
                    >Nombre Completo</label
                  >
                  <input
                    class="w-full bg-surface-bright border border-outline-variant rounded-lg p-md focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all font-body-md"
                    placeholder="Juan Pérez"
                    type="text"
                  />
                </div>
                <div class="space-y-xs">
                  <label
                    class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider"
                    >Empresa</label
                  >
                  <input
                    class="w-full bg-surface-bright border border-outline-variant rounded-lg p-md focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all font-body-md"
                    placeholder="Tech Solutions S.A."
                    type="text"
                  />
                </div>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                <div class="space-y-xs">
                  <label
                    class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider"
                    >Correo Electrónico</label
                  >
                  <input
                    class="w-full bg-surface-bright border border-outline-variant rounded-lg p-md focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all font-body-md"
                    placeholder="juan@empresa.com"
                    type="email"
                  />
                </div>
                <div class="space-y-xs">
                  <label
                    class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider"
                    >Teléfono</label
                  >
                  <input
                    class="w-full bg-surface-bright border border-outline-variant rounded-lg p-md focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all font-body-md"
                    placeholder="+57 300 000 0000"
                    type="tel"
                  />
                </div>
              </div>
              <div class="space-y-xs">
                <label
                  class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider"
                  >Mensaje</label
                >
                <textarea
                  class="w-full bg-surface-bright border border-outline-variant rounded-lg p-md focus:ring-2 focus:ring-primary focus:border-primary outline-none transition-all font-body-md"
                  placeholder="¿Cómo podemos ayudarte?"
                  rows="4"></textarea>
              </div>
              <button
                class="w-full md:w-auto bg-primary text-on-primary px-xl py-md rounded-lg font-label-md font-bold hover:shadow-lg transition-all active:opacity-80"
                type="submit"
              >
                Solicitar Información
              </button>
            </form>
          </div>
        </div>
        <!-- Contact Info & Map Section -->
        <div class="lg:col-span-5 space-y-gutter">
          <!-- Contact Cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
            <div
              class="bg-surface-container-low p-lg border border-outline-variant rounded-xl flex flex-col gap-sm"
            >
              <span
                class="material-symbols-outlined text-primary"
                data-icon="mail">mail</span
              >
              <p
                class="font-label-sm text-label-sm text-on-surface-variant uppercase"
              >
                Escríbenos
              </p>
              <p class="font-body-md text-body-md font-bold">
                hi@nordikhat.com
              </p>
            </div>
            <a
              href="https://wa.me/573108147655"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-surface-container-low p-lg border border-outline-variant rounded-xl flex flex-col gap-sm hover:shadow-md hover:bg-surface-container-lowest transition-all cursor-pointer group"
            >
              <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M12.031 0C5.385 0 0 5.385 0 12.031c0 2.12.553 4.17 1.603 5.975L.194 23.23l5.37-1.408c1.742.946 3.693 1.446 5.672 1.446h.005c6.645 0 12.03-5.385 12.03-12.03 0-3.22-1.254-6.248-3.53-8.525C17.464 1.254 14.436 0 12.031 0zm.005 21.365h-.003c-1.782 0-3.528-.479-5.06-1.387l-.363-.215-3.766.988.995-3.673-.236-.375c-.997-1.583-1.523-3.42-1.523-5.305 0-5.545 4.512-10.056 10.058-10.056 2.686 0 5.21 1.047 7.108 2.947 1.9 1.9 2.946 4.425 2.946 7.11 0 5.545-4.51 10.056-10.056 10.056zm5.517-7.535c-.302-.15-1.788-.883-2.064-.984-.277-.101-.478-.151-.678.151-.202.302-.781.984-.958 1.185-.177.202-.353.227-.655.076-2.12-.998-3.411-2.083-4.521-3.957-.116-.197.108-.184.402-.477.101-.1.202-.236.302-.353.1-.116.134-.202.202-.353.067-.15.034-.277-.016-.378-.051-.101-.679-1.637-.931-2.242-.244-.59-.492-.51-.679-.519l-.58-.009c-.201 0-.528.076-.804.378-.277.302-1.056 1.033-1.056 2.518s1.082 2.921 1.233 3.123c.151.202 2.129 3.25 5.155 4.557.72.311 1.282.497 1.721.636.722.228 1.381.196 1.9.119.58-.088 1.788-.731 2.04-1.437.252-.705.252-1.31.177-1.437-.076-.126-.277-.202-.579-.353z"/>
              </svg>
              <p
                class="font-label-sm text-label-sm text-on-surface-variant uppercase"
              >
                WhatsApp
              </p>
              <p class="font-body-md text-body-md font-bold">
                +57 310 814 7655
              </p>
            </a>
            <div
              class="bg-surface-container-low p-lg border border-outline-variant rounded-xl flex flex-col gap-sm"
            >
              <span
                class="material-symbols-outlined text-primary"
                data-icon="location_on">location_on</span
              >
              <p
                class="font-label-sm text-label-sm text-on-surface-variant uppercase"
              >
                Ubicación
              </p>
              <p class="font-body-md text-body-md font-bold">
                Bucaramanga, Santander, Colombia
              </p>
            </div>
            <div
              class="bg-surface-container-low p-lg border border-outline-variant rounded-xl flex flex-col gap-sm"
            >
              <span
                class="material-symbols-outlined text-primary"
                data-icon="schedule">schedule</span
              >
              <p
                class="font-label-sm text-label-sm text-on-surface-variant uppercase"
              >
                Horario
              </p>
              <p class="font-body-md text-body-md font-bold">
                Lun - Vie, 8am - 6pm
              </p>
            </div>
          </div>
          <!-- Interactive Map -->
          <div
            class="relative w-full h-64 bg-surface-dim border border-outline-variant rounded-xl overflow-hidden shadow-inner group"
          >
            <iframe
              src="https://maps.google.com/maps?q=Bucaramanga,%20Santander,%20Colombia&t=&z=13&ie=UTF8&iwloc=&output=embed"
              width="100%"
              height="100%"
              frameborder="0"
              style="border:0; filter: contrast(1.1) saturate(1.2);"
              allowfullscreen=""
              aria-hidden="false"
              tabindex="0"
              title="Mapa de ubicación en Bucaramanga"
            ></iframe>
            <a href="https://www.google.com/maps?q=Bucaramanga,+Santander,+Colombia" target="_blank" rel="noopener noreferrer">
              <div
                class="absolute bottom-md right-md bg-surface-container-lowest px-md py-xs rounded-full text-label-sm font-bold shadow-md hover:bg-primary hover:text-white transition-colors cursor-pointer"
              >
                Ver en Google Maps
              </div>
            </a>
          </div>
        </div>
      </div>
      <!-- FAQ Section -->
      <section class="mt-32">
        <div class="max-w-3xl mx-auto">
          <div class="text-center mb-xl">
            <h2 class="font-headline-lg text-headline-lg text-on-surface mb-sm">
              Preguntas Frecuentes
            </h2>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Resolvemos tus dudas iniciales sobre nuestros servicios.
            </p>
          </div>
          <div class="space-y-md">
            <!-- Accordion Item 1 -->
            <div
              class="accordion-item border border-outline-variant rounded-xl bg-surface-container-lowest overflow-hidden"
            >
              <button
                class="w-full flex items-center justify-between p-lg text-left hover:bg-surface-container-low transition-colors"
              >
                <span
                  class="font-label-md text-label-md text-on-surface font-bold"
                  >¿Qué tipo de software desarrollan?</span
                >
                <span
                  class="material-symbols-outlined rotate-icon transition-transform"
                  data-icon="expand_more">expand_more</span
                >
              </button>
              <div class="accordion-content">
                <div
                  class="px-lg pb-lg pt-4 font-body-md text-body-md text-on-surface-variant"
                >
                  Nos especializamos en aplicaciones web a medida, sistemas ERP
                  empresariales, soluciones de infraestructura cloud y
                  aplicaciones móviles nativas o híbridas.
                </div>
              </div>
            </div>
            <!-- Accordion Item 2 -->
            <div
              class="accordion-item border border-outline-variant rounded-xl bg-surface-container-lowest overflow-hidden"
            >
              <button
                class="w-full flex items-center justify-between p-lg text-left hover:bg-surface-container-low transition-colors"
              >
                <span
                  class="font-label-md text-label-md text-on-surface font-bold"
                  >¿Cuánto tiempo toma implementar una solución?</span
                >
                <span
                  class="material-symbols-outlined rotate-icon transition-transform"
                  data-icon="expand_more">expand_more</span
                >
              </button>
              <div class="accordion-content">
                <div
                  class="px-lg pb-lg pt-4 font-body-md text-body-md text-on-surface-variant"
                >
                  El tiempo varía según la complejidad. Un MVP (Producto Mínimo
                  Viable) suele tomar entre 8 y 12 semanas, mientras que
                  sistemas corporativos robustos pueden requerir de 4 a 8 meses.
                </div>
              </div>
            </div>
            <!-- Accordion Item 3 -->
            <div
              class="accordion-item border border-outline-variant rounded-xl bg-surface-container-lowest overflow-hidden"
            >
              <button
                class="w-full flex items-center justify-between p-lg text-left hover:bg-surface-container-low transition-colors"
              >
                <span
                  class="font-label-md text-label-md text-on-surface font-bold"
                  >¿Ofrecen soporte post-lanzamiento?</span
                >
                <span
                  class="material-symbols-outlined rotate-icon transition-transform"
                  data-icon="expand_more">expand_more</span
                >
              </button>
              <div class="accordion-content">
                <div
                  class="px-lg pb-lg pt-4 font-body-md text-body-md text-on-surface-variant"
                >
                  Sí, incluimos un periodo de garantía por errores y ofrecemos
                  planes de mantenimiento preventivo y correctivo de largo plazo
                  para asegurar la continuidad de su negocio.
                </div>
              </div>
            </div>
            <!-- Accordion Item 4 -->
            <div
              class="accordion-item border border-outline-variant rounded-xl bg-surface-container-lowest overflow-hidden"
            >
              <button
                class="w-full flex items-center justify-between p-lg text-left hover:bg-surface-container-low transition-colors"
              >
                <span
                  class="font-label-md text-label-md text-on-surface font-bold"
                  >¿Cómo garantizan la seguridad de los datos?</span
                >
                <span
                  class="material-symbols-outlined rotate-icon transition-transform"
                  data-icon="expand_more">expand_more</span
                >
              </button>
              <div class="accordion-content">
                <div
                  class="px-lg pb-lg pt-4 font-body-md text-body-md text-on-surface-variant"
                >
                  Implementamos estándares de seguridad líderes en la industria
                  como encriptación AES-256, auditorías periódicas de código y
                  cumplimiento estricto con la Ley de Protección de Datos
                  Personales.
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>
  <style>
    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
    }
    .accordion-item.active .accordion-content {
      max-height: 200px;
    }
    .accordion-item.active .rotate-icon {
      transform: rotate(180deg);
    }
  </style>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      // Accordion
      const accordionButtons = document.querySelectorAll(
        ".accordion-item button",
      );
      accordionButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const item = button.parentElement;
          const isOpen = item?.classList.contains("active");

          document.querySelectorAll(".accordion-item").forEach((el) => {
            el.classList.remove("active");
          });

          if (!isOpen && item) {
            item.classList.add("active");
          }
        });
      });

      // Form submission
      const contactForm = document.getElementById(
        "contact-form",
      ) as HTMLFormElement;
      if (contactForm) {
        contactForm.addEventListener("submit", function (e) {
          e.preventDefault();
          const btn = e.target.querySelector("button");
          if (!btn) return;

          const originalText = btn.innerText;
          btn.innerText = "Enviando...";
          btn.disabled = true;

          setTimeout(() => {
            btn.innerText = "¡Mensaje Enviado!";
            btn.classList.replace("bg-primary", "bg-green-600");
            contactForm.reset();
            setTimeout(() => {
              btn.innerText = originalText;
              btn.classList.replace("bg-green-600", "bg-primary");
              btn.disabled = false;
            }, 3000);
          }, 1500);
        });
      }
    });
  </script>
</Layout>
