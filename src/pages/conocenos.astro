---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Nosotros | Nordikhat Software Solutions">
  <main class="pt-16">
    <!-- Hero / History Section -->
    <section
      class="py-xl md:py-[80px] px-margin-mobile md:px-margin-desktop max-w-max-width mx-auto"
    >
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-xl items-center">
        <div class="fade-in-up">
          <span
            class="text-primary font-label-sm uppercase tracking-wider mb-sm block"
            >Nuestra Trayectoria</span
          >
          <h1 class="font-headline-xl text-headline-xl mb-lg text-on-surface">
            Forjando el futuro digital desde la excelencia técnica.
          </h1>
          <p class="font-body-lg text-body-lg text-on-surface-variant mb-xl">
            Somos dos amigos apasionados por la tecnología que, tras casi 4 años
            acumulando experiencia en el desarrollo de software para grandes
            empresas, decidimos unir nuestros conocimientos para crear
            Nordikhat. Nuestro objetivo es llevar ese estándar de calidad
            corporativa a negocios de todos los tamaños, construyendo soluciones
            digitales robustas, elegantes y verdaderamente útiles.
          </p>
          <div class="flex gap-lg border-l-2 border-primary-container pl-lg">
            <div>
              <div class="font-headline-md text-headline-md text-primary">
                +4
              </div>
              <div class="font-label-sm text-label-sm text-on-surface-variant">
                Años de Experiencia
              </div>
            </div>
            <div>
              <!-- <div class="font-headline-md text-headline-md text-primary"></div>
<div class="font-label-sm text-label-sm text-on-surface-variant">Fundadores</div>
</div>
<div>
<div class="font-headline-md text-headline-md text-primary">100%</div>
<div class="font-label-sm text-label-sm text-on-surface-variant">Compromiso</div> -->
            </div>
          </div>
        </div>
        <div
          class="relative rounded-xl overflow-hidden shadow-lg h-[400px] md:h-[500px] fade-in-up"
          style="animation-delay: 0.2s"
        >
          <img
            alt="Oficina Nordikhat"
            class="w-full h-full object-cover"
            data-alt="A bright, modern corporate office space in Madrid with clean lines and high ceilings. Large floor-to-ceiling windows allow soft, natural daylight to illuminate a minimalist meeting area featuring premium white furniture and subtle blue accents. The atmosphere is professional, serene, and technologically advanced, reflecting a high-tier software development company's focus on clarity and reliability."
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuCxc2zzX5qqIsZLKH4X4i0QlGfasel4UYREVqAz7nB1tPPpZIfgt8YiweCR6Oq2qxqfNr5-EuOIua-Q-T1O-tgGnOSm8mHd-7xYMvLRoCJY4BY4b-zblDGcF5Pr23qBug8-tVT7VNChJrL6S_3HVlLMxhnWS_YDsaXoZc1-MrTgG8XXFntO3KbmdT1ad7lKPw78y6Ds3BObuCP3Qd2odx4zDMEJhxBP4IJaDTIGF7yW2W4LQvms034JL6quEug6DJqicf99RuDoATo"
          />
        </div>
      </div>
    </section>
    <!-- Mission, Vision, Values (Asymmetric Cards) -->
    <section class="bg-surface-container-low py-xl md:py-[80px]">
      <div
        class="px-margin-mobile md:px-margin-desktop max-w-max-width mx-auto"
      >
        <div class="text-center mb-xl">
          <h2 class="font-headline-lg text-headline-lg text-on-surface">
            Propósito y Fundamentos
          </h2>
          <p
            class="font-body-md text-body-md text-on-surface-variant max-w-2xl mx-auto mt-sm"
          >
            Nuestros pilares estratégicos definen cada decisión que tomamos y
            cada solución que entregamos.
          </p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
          <!-- Mission -->
          <div
            class="bg-surface-container-lowest p-xl rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow group fade-in-up"
          >
            <div
              class="bg-primary-fixed text-on-primary-fixed w-12 h-12 rounded-lg flex items-center justify-center mb-lg group-hover:scale-110 transition-transform"
            >
              <span class="material-symbols-outlined" data-icon="rocket_launch"
                >rocket_launch</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md mb-md">Misión</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Empoderar a las organizaciones globales mediante arquitecturas de
              software escalables, seguras y centradas en el usuario,
              transformando desafíos operativos en ventajas competitivas.
            </p>
          </div>
          <!-- Vision -->
          <div
            class="bg-surface-container-lowest p-xl rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow group fade-in-up"
            style="animation-delay: 0.1s"
          >
            <div
              class="bg-primary-fixed text-on-primary-fixed w-12 h-12 rounded-lg flex items-center justify-center mb-lg group-hover:scale-110 transition-transform"
            >
              <span class="material-symbols-outlined" data-icon="visibility"
                >visibility</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md mb-md">Visión</h3>
            <p class="font-body-md text-body-md text-on-surface-variant">
              Liderar la transición hacia una economía digital más eficiente,
              siendo reconocidos mundialmente por nuestra integridad técnica y
              nuestra pasión por la excelencia.
            </p>
          </div>
          <!-- Values -->
          <div
            class="bg-surface-container-lowest p-xl rounded-xl border border-outline-variant shadow-sm hover:shadow-md transition-shadow group fade-in-up"
            style="animation-delay: 0.2s"
          >
            <div
              class="bg-primary-fixed text-on-primary-fixed w-12 h-12 rounded-lg flex items-center justify-center mb-lg group-hover:scale-110 transition-transform"
            >
              <span class="material-symbols-outlined" data-icon="verified"
                >verified</span
              >
            </div>
            <h3 class="font-headline-md text-headline-md mb-md">Valores</h3>
            <ul
              class="font-body-md text-body-md text-on-surface-variant space-y-xs"
            >
              <li class="flex items-center gap-sm">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Transparencia
                Radical
              </li>
              <li class="flex items-center gap-sm">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Rigor Tecnológico
              </li>
              <li class="flex items-center gap-sm">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Empatía
                con el Cliente
              </li>
              <li class="flex items-center gap-sm">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span> Mejora Continua
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
  <style>
    .bento-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 24px;
    }
    .fade-in-up {
      animation: fadeInUp 0.6s ease-out forwards;
      opacity: 0;
    }
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  </style>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const observerOptions = {
        threshold: 0.1,
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("fade-in-up");
            observer.unobserve(entry.target);
          }
        });
      }, observerOptions);

      document.querySelectorAll("section").forEach((section) => {
        section.style.opacity = "0";
        section.classList.add("transition-opacity", "duration-700");
        observer.observe(section);
      });

      setTimeout(() => {
        document.querySelectorAll("section").forEach((s) => {
          if (s instanceof HTMLElement) s.style.opacity = "1";
        });
      }, 100);
    });
  </script>
</Layout>
